# Server-side environment for the functions in api/.
# Set these in your hosting provider's environment settings (or .env.local for local dev).
# Never commit real values. Never prefix the service key with REACT_APP_.

# Supabase: Project Settings → API (URL and the service_role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs used in form rate limiting
FORM_IP_SALT=

# Optional: also copy submissions to Google Sheets (Apps Script web app URL)
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: email the team for each new submission via Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
